generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Expense {
  id         String   @id @default(cuid())
  phone      String
  date       String
  category   String
  amount     Float
  workerName String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Animal {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // "cow" | "buffalo"
  age       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyEntry {
  id          String   @id @default(cuid())
  phone       String
  date        String
  animalName  String
  animalType  String
  session     String   @default("morning")
  quantity    Float
  rate        Float
  totalAmount Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
